# Ignore node_modules in both backend and frontend
**/node_modules/

# Ignore environment files
**/.env
**/.env.local
**/.env.*.local

# Build outputs
backend/dist/
frontend/dist/
frontend/build/

# Logs
**/logs/
**/*.log

# OS junk
.DS_Store
Thumbs.db

# Editor folders (optional – keep if you share workspace config)
.vscode/
.idea/

# Temp files
*.tmp
*.swp

# personal stuff for mental sanity
/git_commits_layout.txt
/session_notes.txt